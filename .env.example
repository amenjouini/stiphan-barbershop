# Copy to .env and adjust. Never commit the real .env.

# --- Server ---
PORT=4000
NODE_ENV=development
# Public URL of the site, used to build links inside emails.
APP_URL=http://localhost:4000
# SQLite database file (created automatically).
DATABASE_PATH=./data/clubbarber.db
# Set to "true" when the app is served over HTTPS (marks the session cookie Secure).
COOKIE_SECURE=false
# Set to the number of reverse proxies in front of the app (e.g. 1 behind nginx / Render / Fly).
TRUST_PROXY=0

# Demo hosting only: load the demo data whenever the server starts with an empty database
# (free hosts without a disk lose the database on every restart). Leave unset for real use.
SEED_DEMO_ON_START=

# --- Email (optional) ---
# Leave SMTP_HOST empty to run in SIMULATED mode: emails are stored in the
# admin Outbox and printed to the server log, never delivered.
SMTP_HOST=
SMTP_PORT=587
# "true" for implicit TLS (port 465), "false" for STARTTLS (587).
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# From header, e.g. "Club Barber <bookings@yourdomain.tn>"
EMAIL_FROM=

# --- First owner account (used by `npm run create-owner`) ---
OWNER_EMAIL=
OWNER_PASSWORD=
OWNER_NAME=
