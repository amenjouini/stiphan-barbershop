{
  "name": "club-barber",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Barbershop booking, staff management and accounting web app",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c yellow,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "tsx server/index.ts",
    "migrate": "tsx server/migrate.ts",
    "seed": "tsx server/seed.ts",
    "create-owner": "tsx server/create-owner.ts",
    "reset:demo": "tsx server/seed.ts --reset",
    "reset:empty": "tsx server/seed.ts --reset --empty",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json && tsc --noEmit -p tsconfig.e2e.json",
    "test": "tsx --test --test-concurrency=1 server/tests/*.test.ts",
    "test:e2e": "tsx e2e/smoke.ts"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.1.0",
    "@fontsource/amiri": "^5.3.0",
    "@fontsource/instrument-serif": "^5.1.0",
    "@fontsource/tajawal": "^5.3.0",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "nodemailer": "^6.9.16",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "tsx": "^4.19.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "playwright-core": "^1.49.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
